# Føniks — miljøkonfigurasjon. Kopier til .env og fyll inn.
# Ingen nøkler hører hjemme i git. .env er i .gitignore.

# ─── Portneren (agent 11): datakilder ────────────────────────────────────────

# Kontaktpunkt som sendes i User-Agent. Ikke pynt: en identifiserbar klient med
# en e-postadresse blir kontaktet når den er til bry, en anonym blir sperret.
FENIKS_KONTAKT=drift@ditt-domene.no

# eBay: registrer en applikasjon på developer.ebay.com.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# X API v2: bearer-token fra utviklerportalen. Gratisnivået holder ikke til en
# driftsløkke — verifiser nivå, kvote og pris før du dimensjonerer på det.
X_BEARER_TOKEN=

# Temu har ingen offentlig produktdata-API. Det finnes ingen variabel å sette
# her; kilden er avvist i koden. Se src/agent11-portner/kilder.ts.

# ─── Livvakten (agent 12): eksekveringsruting ────────────────────────────────

# Privat innsendingsvei for Ethereum L1. Standardverdiene i ruting.ts trenger
# ingen nøkkel; sett disse bare hvis du bruker et betalt endepunkt.
FENIKS_PRIVAT_RPC=https://rpc.flashbots.net/fast
FENIKS_RPC_L1=
FENIKS_RPC_BASE=

# ─── Skattemesteren (agent 13) ───────────────────────────────────────────────

# Friksjonstaket i basispunkter. 500 = 5 %. Husk at dette er en 20x-regel:
# brutto må være minst 20x friksjonen. Kjør `npm run demo` for tallene.
FENIKS_MAKS_FRIKSJON_BPS=500

# ─── Orkestrator: hjerteslag og vaktbikkje ───────────────────────────────────

FENIKS_PULS_NOKKEL=feniks:puls
FENIKS_PULS_KATALOG=/var/feniks/puls

# Sett vert for å bruke Redis i stedet for delt filvolum. Nødvendig når
# vaktbikkja kjører på en annen maskin enn Orkestratoren.
FENIKS_REDIS_VERT=
FENIKS_REDIS_PORT=6379

# Containeren vaktbikkja skal starte på nytt.
FENIKS_CONTAINER=feniks-master
FENIKS_VAKT_INTERVALL_MS=60000

# Vaktbikkja er i tørrkjøring til denne er nøyaktig «ja». Bevæpn den bevisst.
FENIKS_VAKT_BEVAEPNET=nei

# ─── Nøkler til hvelvene ─────────────────────────────────────────────────────

# Det finnes bevisst ingen variabel for private nøkler her. Hvelvene i
# lommebokisolasjon.ts arbeider med *referanser* til en ekstern signerer
# (KMS-/HSM-nøkkel-id), ikke med nøkkelmateriale. Å legge en nøkkel som styrer
# hele katalysatoren i miljøet til prosessen med størst angrepsflate er den ene
# feilen som gjør alle de andre forsvarene irrelevante.
FENIKS_KMS_ENDEPUNKT=
FENIKS_KMS_NOKKEL_IDER=
